# PostgreSQL
POSTGRES_PASSWORD=payment_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://payment_user:payment_password@localhost:5432/payments_db

# RabbitMQ
RABBITMQ_PASSWORD=payment_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://payment_user:payment_password@localhost:5672/

# API
API_KEY=replace-with-a-random-secret
API_PORT=8000

# Consumer
OUTBOX_POLL_INTERVAL=1
WEBHOOK_TIMEOUT=5
RETRY_BASE_DELAY=2
